{
  "name": "standwise-functions",
  "private": true,
  "description": "Standwise Cloud Functions (spec \u00a77).",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/*.test.ts\"",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-standwise --config ../firebase.json \"node --test test/emulator/*.test.ts\"",
    "serve": "npm run build && firebase emulators:start --config ../firebase.json"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
