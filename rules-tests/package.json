{
  "name": "standwise-rules-tests",
  "private": true,
  "type": "module",
  "description": "Firestore security rules tests (run against the emulator).",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-standwise --config ../firebase.json \"node --test test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "firebase": "^13.2.0",
    "typescript": "^5.9.3"
  }
}
